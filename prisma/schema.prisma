datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Post {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  content        String
  category       String    // "devlog" | "troubleshooting" | "product" | "agent" | "blueprint"
  tags           String    @default("[]") // JSON-encoded array
  published      Boolean   @default(true)
  locale         String    @default("ko") // "ko" | "en"
  translationKey String?   // same value links ko/en versions of same post
  pinned         Boolean   @default(false) // exactly one post pinned at a time
  githubRepo     String    @default("") // e.g. "GatsLee/Page_Node"
  coverImage     String    @default("") // URL to cover image
  description    String    @default("") // SEO/preview excerpt

  // Product/Agent structured fields (nullable — only used when category is "product" or "agent")
  demoVideo      String?   // URL to demo video
  demoImages     String?   // JSON array of image URLs: '["url1","url2"]'
  targetAudience String?
  purpose        String?
  expectedEffect String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  comments       Comment[]
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String   // "/uploads/1234-image.png"
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String   @default("/")
  createdAt DateTime @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime @default(now())
}

model GuestbookEntry {
  id        Int      @id @default(autoincrement())
  author    String
  message   String
  createdAt DateTime @default(now())
}

model AdminUser {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}

model ProgressItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  category    String   // "hardware", "software", "network", "ai"
  completed   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
